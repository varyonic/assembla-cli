# Copy to .assembla.yml and fill in your credentials.
# Alternatively, set ASSEMBLA_API_KEY, ASSEMBLA_API_SECRET, ASSEMBLA_SPACE env vars.
#
# Get your API key/secret at: https://www.assembla.com/user/edit/manage_clients

api_key: "your-api-key"
api_secret: "your-api-secret"
space: "your-space-wiki-name"
